<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentApp.Views.SettingsPage"
    Title="Налаштування"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

    <VerticalStackLayout
        Padding="25"
        Spacing="20">

        <Label
            Text="Налаштування застосунку"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

        <Label
            Text="Темна тема"
            FontSize="18"
            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

        <Switch
            x:Name="ThemeSwitch"
            Toggled="ThemeSwitch_Toggled"
            HorizontalOptions="Start" />

        <Label
            Text="Увімкніть перемикач для темної теми"
            FontSize="14"
            TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

    </VerticalStackLayout>

</ContentPage>