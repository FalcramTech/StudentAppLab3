<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentApp.Views.StudentDetailPage"
    Title="Деталі студента">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Деталі студента"
            FontSize="22"
            FontAttributes="Bold" />

        <Label Text="{Binding FullName, StringFormat='ПІБ: {0}'}" />

        <Label Text="{Binding Group, StringFormat='Група: {0}'}" />

        <Label Text="Середній бал:" />

        <Entry
            Text="{Binding AverageScore, Mode=TwoWay}"
            Keyboard="Numeric" />

        <Button
            Text="Зберегти"
            Command="{Binding SaveCommand}" />

        <Button
            Text="Назад"
            Command="{Binding GoBackCommand}" />
    </VerticalStackLayout>

</ContentPage>