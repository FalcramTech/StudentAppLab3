<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentApp.Views.StudentDetailPage"
    Title="Деталі студента">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Деталі студента"
                FontSize="22"
                FontAttributes="Bold" />

            <Label Text="ПІБ:" />

            <Entry
                Text="{Binding FullName, Mode=TwoWay}"
                Placeholder="Введіть ПІБ" />

            <Label Text="Група:" />

            <Entry
                Text="{Binding Group, Mode=TwoWay}"
                Placeholder="Введіть групу" />

            <Label Text="Середній бал:" />

            <Entry
                Text="{Binding AverageScore, Mode=TwoWay}"
                Keyboard="Numeric" />

            <!-- Нове поле -->
            <Label Text="Номер студентського квитка:" />

            <Entry
                Text="{Binding StudentCardNumber, Mode=TwoWay}"
                Placeholder="Введіть номер студентського квитка"
                Keyboard="Text" />

            <Button
                Text="Зберегти"
                Command="{Binding SaveCommand}" />

            <Button
                Text="Видалити студента"
                BackgroundColor="#C62828"
                TextColor="White"
                Command="{Binding DeleteCommand}" />

            <Button
                Text="Назад"
                Command="{Binding GoBackCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
