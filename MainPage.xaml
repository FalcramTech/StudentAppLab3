<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentApp.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Особистий кабінет студента"
               FontSize="22"
               FontAttributes="Bold" />

        <Entry Text="{Binding FullName, Mode=TwoWay}"
               Placeholder="ПІБ" />

        <Entry Text="{Binding Group, Mode=TwoWay}"
               Placeholder="Група" />

        <Entry Text="{Binding AverageScore, Mode=TwoWay}"
               Placeholder="Середній бал"
               Keyboard="Numeric" />

        <Entry Text="{Binding StudentCardNumber, Mode=TwoWay}"
               Placeholder="Номер студентського квитка"
               Keyboard="Text" />

        <Label Text="{Binding FullName, StringFormat='Студент: {0}'}" />
        <Label Text="{Binding Group, StringFormat='Група: {0}'}" />

        <Label Text="{Binding AverageScore, StringFormat='Бал: {0:F2}'}">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsHighScore}"
                             Value="True">
                    <Setter Property="TextColor" Value="Green" />
                </DataTrigger>

                <DataTrigger TargetType="Label"
                             Binding="{Binding IsHighScore}"
                             Value="False">
                    <Setter Property="TextColor" Value="Red" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Button Text="Додати студента"
                Command="{Binding AddStudentCommand}" />

        <CollectionView ItemsSource="{Binding Students}">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <VerticalStackLayout Padding="10" Spacing="5">

                        <Label Text="{Binding FullName, StringFormat='ПІБ: {0}'}" />
                        <Label Text="{Binding Group, StringFormat='Група: {0}'}" />
                        <Label Text="{Binding AverageScore, StringFormat='Бал: {0:F2}'}" />

                        <Button Text="Детальніше"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.OpenDetailsCommand}"
                                CommandParameter="{Binding .}" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
